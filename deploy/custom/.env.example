# Firecrawl v2.11.192 + SearXNG 2026.8.4-c63835bd2.
# Copy to .env, fill secrets locally, and keep the file outside Git.

# Required. Authentication remains disabled while the API is loopback-only;
# FIRECRAWL_API_KEY is still required as the image's TEST_API_KEY.
FIRECRAWL_API_KEY=
BULL_AUTH_KEY=
SEARXNG_SECRET=
FIRECRAWL_LITELLM_KEY=

# Strongly recommended; Compose otherwise falls back to "postgres".
POSTGRES_PASSWORD=

# LiteLLM routing.
# OPENAI_BASE_URL=http://proxy:4000/v1
FIRECRAWL_MODEL=gpt-4.1-mini
FIRECRAWL_EMBEDDING_MODEL=text-embedding-3-small

# Rendering and search.
# BLOCK_MEDIA=true
# SEARXNG_CATEGORIES=general

# Concurrency overrides.
# NUM_WORKERS_PER_QUEUE=2
# NUQ_WORKER_COUNT=2
# CRAWL_CONCURRENT_REQUESTS=4
# MAX_CONCURRENT_JOBS=2
# BROWSER_POOL_SIZE=4

# LOGGING_LEVEL=WARN
